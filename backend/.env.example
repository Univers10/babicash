# Database (async driver)
DATABASE_URL=postgresql+asyncpg://babicash:babicash@localhost:5432/babicash

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# App
PROJECT_NAME=BabiCash API
API_V1_PREFIX=/api/v1

# CORS (virgule-séparés, ou * pour tout autoriser en dev)
ALLOWED_ORIGINS=*

# OAuth (Google / Apple sign-in) : laisser vide pour désactiver un provider
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Ambassadeurs : solde minimum (FCFA) pour déclencher un versement hebdo.
# En dessous, le solde de l'ambassadeur est reporté à la semaine suivante.
AMBASSADEUR_SEUIL_MIN_PAYOUT=0

# Notifications push (Web Push / VAPID) pour l'espace ambassadeur.
# Vides = push désactivé (les notifications restent visibles in-app uniquement).
# Générer une paire : `vapid --gen` (CLI fournie par py-vapid, dépendance de pywebpush)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:support@babicash.ci
